ENVIRONMENT=production
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

POSTGRES_DB=resumint
POSTGRES_USER=resumint
POSTGRES_PASSWORD=replace-with-url-safe-password

PUBLIC_APP_URL=https://resumint.core456.com
OAUTH_REDIRECT_BASE_URL=https://resumint.core456.com
# Compose trusts the Caddy container at 172.30.0.2 and loopback for local health checks.
TRUSTED_PROXY_IPS=172.30.0.2,127.0.0.1

SMTP_HOST=smtp.example.net
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_FROM=no-reply@resumint.core456.com

# Configure each provider in its developer console with this exact callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Optional third-party OpenID Connect provider
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
